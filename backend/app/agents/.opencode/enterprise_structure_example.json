  "questions": [
    {
      "id": "company_code_selection",
      "type": "multiple_choice",
      "question": "Which company code do you want to configure?",
      "required": true,
      "options": [
        {"value": "US1000", "label": "US Operations (US1000)"},
        {"value": "DE2000", "label": "Germany Operations (DE2000)"},
        {"value": "create_new", "label": "Create new company code"}
      ],
      "conditions": {
        "if": "create_new",
        "show_questions": ["new_company_code_details", "new_company_address"]
      }
    },
    {
      "id": "new_company_code_details",
      "type": "text_input",
      "question": "Enter the new company code (4 digits):",
      "required": true,
      "validation": {
        "pattern": "^[A-Z]{2}[0-9]{4}$",
        "message": "Company code must be 2 letters followed by 4 digits (e.g., UK3000)"
      }
    },
    {
      "id": "new_company_address",
      "type": "address_form",
      "question": "Enter the company address:",
      "required": true,
      "fields": [
        {"name": "street", "label": "Street Address", "required": true},
        {"name": "city", "label": "City", "required": true},
        {"name": "postal_code", "label": "Postal Code", "required": true},
        {"name": "country", "label": "Country", "required": true, "type": "country_select"}
      ]
    },
    {
      "id": "business_area_assignment",
      "type": "multiple_choice",
      "question": "Select the primary business area:",
      "required": true,
      "options": [
        {"value": "BA001", "label": "Manufacturing"},
        {"value": "BA002", "label": "Sales & Distribution"},
        {"value": "BA003", "label": "Research & Development"}
      ]
    },
    {
      "id": "controlling_area_selection",
      "type": "multiple_choice",
      "question": "Select the controlling area:",
      "required": true,
      "options": [
        {"value": "CO001", "label": "North America Controlling"},
        {"value": "CO002", "label": "Europe Controlling"},
        {"value": "create_new", "label": "Create new controlling area"}
      ]
    },
    {
      "id": "fiscal_year_variant",
      "type": "multiple_choice",
      "question": "Select fiscal year variant:",
      "required": true,
      "options": [
        {"value": "K4", "label": "K4 - Oct to Sep"},
        {"value": "V3", "label": "V3 - Jan to Dec"},
        {"value": "V9", "label": "V9 - Apr to Mar"}
      ]
    }
  ],
  "validation_rules": {
    "company_code": {
      "unique": true,
      "length": 6,
      "pattern": "^[A-Z]{2}[0-9]{4}$"
    },
    "business_area": {
      "unique": true,
      "length": 5,
      "pattern": "^BA[0-9]{3}$"
    },
    "controlling_area": {
      "unique": true,
      "length": 5,
      "pattern": "^CO[0-9]{3}$"
    }
  },
  "integration_points": {
    "finance": {
      "gl_accounts": "chart_of_accounts",
      "document_types": "company_code",
      "posting_periods": "fiscal_year_variant"
    },
    "hr": {
      "employee_groups": "company_code",
      "payroll_areas": "company_code"
    },
    "logistics": {
      "plants": "company_code",
      "storage_locations": "plant"
    }
  }
}